# Server
PORT=5001
NODE_ENV=development

# Database — local or MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS — comma-separated list of allowed origins
CLIENT_URL=http://localhost:8080

# Cloudflare R2 (S3-compatible) media storage
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET=your-bucket-name
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Admin account for `npm run seed`
ADMIN_NAME=Your Name
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# AI project import (admin panel → Projects → "Import with AI")
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model (defaults to claude-opus-5-5)
# AI_MODEL=claude-sonnet-5-5

# Email via Resend (password reset, contact-form notifications)
RESEND_API_KEY=re_...
# Must be an address on a domain verified in Resend
MAIL_FROM=Sabbir Ahmad <noreply@bysabbir.com>
# Where "new contact message" notifications are delivered (comma-separate for several)
MAIL_NOTIFY_TO=you@example.com
# Optional Reply-To on system mail, e.g. hello@bysabbir.com (needs inbound routing set up)
# MAIL_REPLY_TO=hello@bysabbir.com
# Public frontend URL used in email links. Defaults to the first CLIENT_URL entry.
SITE_URL=https://bysabbir.com
