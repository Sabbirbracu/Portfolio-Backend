# Added alongside default.conf.template. Does not modify any existing server block.
# Plain nginx (no envsubst variables needed, but $vars are preserved by the image's envsubst).

server {
    listen 80;
    server_name api.bysabbir.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name api.bysabbir.com;

    ssl_certificate     /etc/letsencrypt/live/api.bysabbir.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.bysabbir.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=31536000" always;

    # Media goes to R2 via multer; allow reasonable upload bodies.
    client_max_body_size 25m;

    location / {
        proxy_pass http://portfolio-api:5001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # AI project generation (POST /api/projects/generate) can take a minute or two.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
